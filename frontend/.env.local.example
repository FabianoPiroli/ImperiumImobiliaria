# Em desenvolvimento local, a API NestJS roda na porta 3000.
# Na Vercel, configure a URL pública do backend (não use localhost) nas variáveis do projeto frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase (Configuração do cliente frontend, se aplicável)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-aqui
