{
  "name": "imperium-imobiliaria",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestão Imobiliária Imperium",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  }
}

