# Porta do Servidor
PORT=3000

# URL do Frontend para configuração do CORS
FRONTEND_URL=http://localhost:3001,http://localhost:3000

# Autenticação e Segurança (JWT)
JWT_SECRET=sua-chave-secreta-jwt-super-segura-aqui
ADMIN_EMAIL=admin@imperium.com
ADMIN_PASSWORD=sua-senha-segura-admin

# Conexão com o Banco de Dados PostgreSQL (Supabase / Neon / Local)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
POSTGRES_PRISMA_URL=postgresql://usuario:senha@host:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://usuario:senha@host:5432/postgres?sslmode=require
POSTGRES_URL=postgresql://usuario:senha@host:6543/postgres?sslmode=require
POSTGRES_DATABASE=postgres
POSTGRES_HOST=host
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-aqui
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
SUPABASE_JWT_SECRET=seu-segredo-jwt-supabase-aqui
SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-aqui
SUPABASE_SECRET_KEY=sua-chave-secret-aqui

# Cloudinary (Armazenamento de imagens e vídeos de imóveis)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=