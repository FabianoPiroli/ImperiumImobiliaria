# Porta do Servidor
PORT=3000

# URL do Frontend para configuração do CORS
FRONTEND_URL=http://localhost:3000

# Autenticação e Segurança (JWT)
JWT_SECRET=sua-chave-secreta-jwt-super-segura-aqui
ADMIN_EMAIL=admin@imperium.com
ADMIN_PASSWORD=sua-senha-segura-admin

# Conexão com o Banco de Dados PostgreSQL (Supabase / Neon / Local)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
POSTGRES_PRISMA_URL=postgresql://usuario:senha@host:5432/postgres?pgbouncer=true&connection_limit=1
POSTGRES_URL_NON_POOLING=postgresql://usuario:senha@host:5432/postgres
POSTGRES_DATABASE=postgres
POSTGRES_HOST=host
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha

# Supabase (Opcional se usando direto o PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloudinary (Armazenamento de imagens e vídeos de imóveis)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=