generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Imovel {
  id        Int      @id @default(autoincrement())
  codigo    Int      @unique @default(autoincrement())
  titulo    String
  descricao String
  tipo      String
  estado    String   @default("SC")
  cidade    String
  bairro    String   @default("")
  endereco  String
  preco     Float
  status    String   @default("disponivel")
  finalidade String  @default("venda")
  quartos   Int
  banheiros Int
  vagasGaragem Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  midias    Midia[]
  latitude     Float?
  longitude    Float?
  ocultarNumeroExato   Boolean @default(false)
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Midia {
  id        Int      @id @default(autoincrement())
  url       String
  nome      String
  tipo      String
  mimeType  String
  publicId  String?
  resourceType String @default("image")
  imovelId  Int
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
